# Environment Configuration — PT. BARAK IOMS Frontend
# Copy this file to .env and fill in values. Never commit .env.

# API mode: "mock" uses local mock adapters; "rest" calls VITE_API_BASE_URL
VITE_API_MODE=mock

# Base URL for the REST API (used only when VITE_API_MODE=rest)
VITE_API_BASE_URL=http://localhost:3001/api/v1

# App environment label
VITE_APP_ENV=development
